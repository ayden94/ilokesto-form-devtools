{
  "name": "@ilokesto/form-devtools",
  "version": "0.1.0",
  "description": "A framework-independent, read-only inspector for @ilokesto/form",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:pack": "pnpm build && publint && attw --pack . --profile esm-only",
    "check": "pnpm typecheck && pnpm test && pnpm test:pack",
    "prepublishOnly": "pnpm check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayden94/ilokesto-form-devtools.git"
  },
  "homepage": "https://github.com/ayden94/ilokesto-form-devtools#readme",
  "bugs": {
    "url": "https://github.com/ayden94/ilokesto-form-devtools/issues"
  },
  "sideEffects": [
    "./dist/register.js",
    "./dist/react.js"
  ],
  "keywords": [
    "form",
    "devtools",
    "web-components",
    "lit"
  ],
  "author": "Jeong Jinho <wpfekdml@me.com>",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "dependencies": {
    "@lit/react": "^1.0.8",
    "lit": "^3.3.3"
  },
  "peerDependencies": {
    "@ilokesto/form": "^2.0.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ilokesto/form": "^2.0.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@arethetypeswrong/cli": "^0.18.5",
    "jsdom": "^27.4.0",
    "publint": "^0.3.25",
    "react": "^19.0.0",
    "react-dom": "^19.2.6",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
